<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label="ダークモードに切り替える" title="ダークモードに切り替える"><span data-theme-icon aria-hidden="true">☾</span></button>
<style>
.theme-toggle { width:44px; height:44px; min-width:44px; display:inline-grid; place-items:center; border:1px solid currentColor; border-radius:50%; background:transparent; color:inherit; cursor:pointer; padding:0; font-family:Arial,sans-serif; line-height:1; font-size:24px; opacity:.85; }
.theme-toggle:hover{opacity:1}.theme-toggle:focus-visible{outline:3px solid #91aa62;outline-offset:4px}@media(max-width:480px){.theme-toggle{width:38px;height:38px;min-width:38px;font-size:22px}}
</style>
