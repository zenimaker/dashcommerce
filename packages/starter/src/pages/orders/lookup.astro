---
import Shop from "../../layouts/Shop.astro";
import { SANDBOXED } from "../../lib/edition";

// Core-only feature: not available in the sandboxed edition.
if (SANDBOXED) return new Response("ページが見つかりません", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
---
<Shop title="注文を検索" description="注文IDから過去の注文を表示します。">
	<div class="container-narrow" style="padding: 3rem 0;">
		<h1>注文を検索</h1>
		<p class="lead">
			確認メールには領収書へのリンク
			<code>/thank-you/&lt;注文ID&gt;</code>
			が入っています。ID、またはリンク全体を下に貼り付けてください。
		</p>

		<form id="lookup" class="lookup-form" novalidate>
			<label class="lk-label">
				<span>注文IDまたは領収書のリンク</span>
				<input
					id="orderId"
					required
					autocomplete="off"
					placeholder="01K…  または  https://…/thank-you/01K…"
				/>
			</label>
			<p id="lk-error" role="alert" class="lk-error"></p>
			<button type="submit" class="btn-primary">注文を表示</button>
		</form>

		<p class="fineprint">
			メールが見つからない場合は、迷惑メールもご確認ください。それでもないときは、
			<a href="mailto:support">サポート</a>へ、注文時のメールアドレスとおおよその日付をお知らせください。
		</p>
	</div>
</Shop>

<style>
	.lead { color: var(--text-muted); max-width: 42rem; }
	.lead code {
		background: var(--bg-3, var(--bg-2));
		padding: 1px 6px;
		border-radius: 3px;
		font-family: var(--font-mono);
		font-size: .85em;
		color: var(--text);
	}
	.lookup-form {
		display: grid; gap: 1rem;
		max-width: 30rem;
		margin-top: 2rem;
		padding: 1.5rem;
		background: var(--bg-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg, var(--radius));
	}
	.lk-label {
		display: flex; flex-direction: column; gap: .4rem;
		font-size: .82rem; font-weight: 500; color: var(--text-muted);
	}
	.lk-label input {
		padding: .7rem .9rem;
		background: var(--bg-3, #fff);
		color: var(--text);
		border: 1px solid var(--border-mid, var(--border));
		border-radius: var(--radius);
		font-family: var(--font-sans);
		font-size: .9rem;
	}
	.lk-label input:focus {
		outline: none;
		border-color: var(--gold);
		box-shadow: 0 0 0 3px var(--gold-dim);
	}
	.lk-error {
		color: var(--ember, #a00);
		font-size: .875rem;
		margin: 0;
		min-height: 1.2em;
	}
	.fineprint { margin-top: 2rem; color: var(--text-muted); font-size: .85rem; }
	.fineprint a { color: var(--gold); }
</style>

<script>
	const form  = document.getElementById("lookup") as HTMLFormElement | null;
	const input = document.getElementById("orderId") as HTMLInputElement | null;
	const err   = document.getElementById("lk-error");
	const setErr = (m: string | null) => { if (err) err.textContent = m ?? ""; };

	// Accept either a bare ID or a full /thank-you/<id> URL.
	function extractId(raw: string): string | null {
		const trimmed = raw.trim();
		if (!trimmed) return null;
		const urlMatch = trimmed.match(/\/thank-you\/([^/?#]+)/i);
		const id = urlMatch ? urlMatch[1] : trimmed;
		return /^[A-Za-z0-9_-]{8,}$/.test(id) ? id : null;
	}

	form?.addEventListener("submit", (e) => {
		e.preventDefault();
		setErr(null);
		const id = extractId(input?.value ?? "");
		if (!id) {
			setErr("注文IDの形式ではないようです。領収書のメールをご確認ください。");
			return;
		}
		window.location.href = `/thank-you/${encodeURIComponent(id)}`;
	});
</script>
