---
import ThemeInit from "../components/ThemeInit.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import "../styles/home-preserved.css";
const pageTitle = "\u30C0\u30C3\u30B7\u30E5\u30B3\u30DE\u30FC\u30B9\uFF5C\u3042\u306A\u305F\u306E\u5546\u54C1\u306B\u3001\u3082\u3063\u3068\u4F1D\u308F\u308B\u58F2\u308A\u5834\u3092\u3002";
const description = "\u5546\u54C1\u8CA9\u58F2\u3082\u3001\u5B9A\u671F\u8CFC\u5165\u3082\u3001\u30D6\u30E9\u30F3\u30C9\u306E\u767A\u4FE1\u3082\u3002\u30C0\u30C3\u30B7\u30E5\u30B3\u30DE\u30FC\u30B9\u306F\u3001\u5546\u54C1\u306E\u9B45\u529B\u3092\u4F1D\u3048\u308B\u58F2\u308A\u5834\u3068\u65E5\u3005\u306E\u904B\u55B6\u3092\u3064\u306A\u3050EC\u30C4\u30FC\u30EB\u3067\u3059\u3002\u6708\u984D9,800\u5186\u3067\u63D0\u4F9B\u4E88\u5B9A\u3002\u516C\u958B\u30C7\u30E2\u3067\u5546\u54C1\u95B2\u89A7\u3068\u30AB\u30FC\u30C8\u3092\u4F53\u9A13\u3067\u304D\u307E\u3059\u3002";
const canonical = new URL("/", Astro.url).toString();
const features = [{n:"01",title:`\u300C\u6B32\u3057\u3044\u300D\u304C\u898B\u3064\u304B\u308B\u3001
\u5546\u54C1\u30DA\u30FC\u30B8\u306B\u3002`,body:"\u5546\u54C1\u3092\u30AB\u30C6\u30B4\u30EA\u30FC\u3067\u6574\u7406\u3057\u3001\u8272\u3084\u30B5\u30A4\u30BA\u306E\u9078\u629E\u80A2\u3082\u3072\u3068\u3064\u306E\u30DA\u30FC\u30B8\u306B\u3002\u304A\u5BA2\u3055\u307E\u304C\u3001\u81EA\u5206\u306B\u5408\u3046\u5546\u54C1\u3092\u9078\u3079\u308B\u58F2\u308A\u5834\u3092\u3064\u304F\u308C\u307E\u3059\u3002",tags:["\u5546\u54C1\u30FB\u30AB\u30C6\u30B4\u30EA\u30FC","\u30D0\u30EA\u30A8\u30FC\u30B7\u30E7\u30F3","\u30AB\u30FC\u30C8"]},{n:"02",title:`\u58F2\u308A\u65B9\u3092\u3001
\u3072\u3068\u3064\u306B\u6C7A\u3081\u306A\u304F\u3066\u3044\u3044\u3002`,body:"\u65E5\u3005\u4F7F\u3046\u30E2\u30CE\u304B\u3089\u3001\u30C0\u30A6\u30F3\u30ED\u30FC\u30C9\u3067\u304D\u308B\u30B3\u30F3\u30C6\u30F3\u30C4\u3001\u5B9A\u671F\u8CFC\u5165\u307E\u3067\u3002\u5C4A\u3051\u305F\u3044\u5546\u54C1\u306B\u5408\u308F\u305B\u3066\u3001\u8CA9\u58F2\u306E\u304B\u305F\u3061\u3092\u5E83\u3052\u3089\u308C\u307E\u3059\u3002",tags:["\u7269\u8CA9","\u30C7\u30B8\u30BF\u30EB\u5546\u54C1","\u5B9A\u671F\u8CFC\u5165"]},{n:"03",title:`\u5546\u54C1\u306E\u80CC\u666F\u307E\u3067\u3001
\u8CB7\u3046\u7406\u7531\u306B\u5909\u3048\u3066\u3044\u304F\u3002`,body:"\u4F7F\u3044\u65B9\u3084\u3064\u304F\u308A\u624B\u306E\u60F3\u3044\u3092\u8A18\u4E8B\u3067\u767A\u4FE1\u3057\u3001\u8A18\u4E8B\u306E\u4E2D\u3067\u5546\u54C1\u3092\u7D39\u4ECB\u3002\u8AAD\u3080\u6642\u9593\u3068\u3001\u5546\u54C1\u3092\u9078\u3076\u6642\u9593\u3092\u3064\u306A\u3052\u3089\u308C\u307E\u3059\u3002",tags:["\u8A18\u4E8B\u306E\u767A\u4FE1","\u8A18\u4E8B\u5185\u306E\u5546\u54C1\u7D39\u4ECB"]}];
const faqs = [["\u516C\u958B\u30C7\u30E2\u3067\u306F\u3001\u4F55\u3092\u8A66\u305B\u307E\u3059\u304B\uFF1F","\u5546\u54C1\u4E00\u89A7\u30FB\u5546\u54C1\u8A73\u7D30\u306E\u95B2\u89A7\u3068\u3001\u30AB\u30FC\u30C8\u3078\u306E\u8FFD\u52A0\u30FB\u6570\u91CF\u5909\u66F4\u30FB\u524A\u9664\u3092\u8A66\u305B\u307E\u3059\u3002\u8A18\u4E8B\u306A\u3069\u3001\u30C7\u30FC\u30BF\u30D9\u30FC\u30B9\u306B\u4FDD\u5B58\u3055\u308C\u305F\u30B5\u30F3\u30D7\u30EB\u539F\u7A3F\u306B\u306F\u82F1\u8A9E\u304C\u6B8B\u3063\u3066\u3044\u308B\u3053\u3068\u304C\u3042\u308A\u307E\u3059\u3002\u5B9F\u969B\u306E\u6CE8\u6587\u30FB\u6C7A\u6E08\u30FB\u30C0\u30A6\u30F3\u30ED\u30FC\u30C9\u3001\u30A2\u30AB\u30A6\u30F3\u30C8\u767B\u9332\u3001\u7BA1\u7406\u753B\u9762\u306F\u5229\u7528\u3067\u304D\u307E\u305B\u3093\u3002"],["\u6708\u984D9,800\u5186\u3067\u3001\u3069\u3053\u307E\u3067\u4F7F\u3048\u307E\u3059\u304B\uFF1F","\u6708\u984D9,800\u5186\u306F\u30B5\u30FC\u30D3\u30B9\u306E\u63D0\u4F9B\u4E88\u5B9A\u4FA1\u683C\u3067\u3059\u3002\u6700\u7D42\u7684\u306A\u63D0\u4F9B\u6A5F\u80FD\u3001\u7A0E\u8FBC\u30FB\u7A0E\u5225\u306E\u6271\u3044\u3001\u521D\u671F\u8CBB\u7528\u3001\u6C7A\u6E08\u624B\u6570\u6599\u3001\u30B5\u30DD\u30FC\u30C8\u7BC4\u56F2\u3001\u5951\u7D04\u30FB\u89E3\u7D04\u6761\u4EF6\u306F\u672A\u5B9A\u3067\u3059\u3002\u6B63\u5F0F\u306A\u63D0\u4F9B\u6761\u4EF6\u306F\u3001\u30B5\u30FC\u30D3\u30B9\u958B\u59CB\u6642\u306B\u3054\u6848\u5185\u3057\u307E\u3059\u3002"],["\u5B9A\u671F\u8CFC\u5165\u3084\u30C7\u30B8\u30BF\u30EB\u5546\u54C1\u306E\u8CA9\u58F2\u306B\u3082\u5BFE\u5FDC\u3067\u304D\u307E\u3059\u304B\uFF1F","\u57FA\u76E4\u3068\u306A\u308BEC\u30C4\u30FC\u30EB\u306B\u306F\u3001\u5B9A\u671F\u8CFC\u5165\u30FB\u30C0\u30A6\u30F3\u30ED\u30FC\u30C9\u5546\u54C1\u306E\u8CA9\u58F2\u6A5F\u80FD\u304C\u3042\u308A\u307E\u3059\u3002\u5B9F\u904B\u7528\u306B\u306F\u6C7A\u6E08\u9023\u643A\u306A\u3069\u306E\u8A2D\u5B9A\u304C\u5FC5\u8981\u3067\u3059\u3002\u516C\u958B\u30C7\u30E2\u3067\u306F\u3053\u308C\u3089\u306E\u8CFC\u5165\u51E6\u7406\u306F\u7121\u52B9\u306B\u3057\u3066\u304A\u308A\u3001\u6B63\u5F0F\u30B5\u30FC\u30D3\u30B9\u3067\u306E\u63D0\u4F9B\u7BC4\u56F2\u306F\u672A\u5B9A\u3067\u3059\u3002"],["\u4ECA\u3059\u3050\u30B5\u30FC\u30D3\u30B9\u3092\u7533\u3057\u8FBC\u3081\u307E\u3059\u304B\uFF1F","\u73FE\u5728\u306F\u30C7\u30E2\u516C\u958B\u30FB\u30B5\u30FC\u30D3\u30B9\u63D0\u4F9B\u6E96\u5099\u4E2D\u3067\u3059\u3002\u3053\u306E\u30DA\u30FC\u30B8\u304B\u3089\u306E\u304A\u7533\u3057\u8FBC\u307F\u3084\u8AB2\u91D1\u306F\u884C\u3063\u3066\u3044\u307E\u305B\u3093\u3002\u307E\u305A\u306F\u516C\u958B\u30C7\u30E2\u3067\u3001\u5546\u54C1\u3092\u9078\u3093\u3067\u30AB\u30FC\u30C8\u306B\u5165\u308C\u308B\u6D41\u308C\u3092\u3054\u78BA\u8A8D\u304F\u3060\u3055\u3044\u3002"]];
---
`<html lang="ja"> <head><meta charset="utf-8"><ThemeInit /><meta name="viewport" content="width=device-width, initial-scale=1"><title>{pageTitle}</title><meta name="description"content={description}><meta name="theme-color" content="#182b25"><link rel="canonical"href={canonical}><meta property="og:type" content="website"><meta property="og:locale" content="ja_JP"><meta property="og:site_name" content="ダッシュコマース"><meta property="og:title"content={pageTitle}><meta property="og:description"content={description}><meta property="og:url"content={canonical}><meta name="twitter:card" content="summary"><meta name="twitter:title"content={pageTitle}><meta name="twitter:description"content={description}></head> <body> <a class="skip" href="#main">本文へ進む</a> <header class="header"> <a class="brand" href="/" aria-label="ダッシュコマース ホーム"><span class="brand-symbol" aria-hidden="true">d<span>↗</span></span><span>ダッシュコマース<small>商いの可能性を、ひろげよう。</small></span></a> <nav aria-label="メインナビゲーション"><a href="#features">できること</a><a href="#pricing">料金</a><a href="#faq">よくある質問</a></nav> <div class="nav-actions"><ThemeToggle /><a class="button nav-cta" href="/shop">デモを体験 <span aria-hidden="true">↗</span></a></div> </header> <main id="main"> <section class="hero wrap" aria-labelledby="hero-title"> <div class="hero-copy"> <p class="eyebrow"><span class="dot" aria-hidden="true"></span>あなたの商いを育てる、ECツール</p> <h1 id="hero-title">あなたの商品に、<br>もっと伝わる<br><em>売り場を。</em></h1> <p class="hero-description">こだわりを届ける。選んでもらう。また出会う。<br class="desktop-break">商品販売も、定期購入も、ブランドの発信も。<br class="desktop-break">あなたらしいお店づくりを、ここから。</p> <div class="hero-actions"><a class="button primary" href="/shop">公開デモで売り場を体験 <span aria-hidden="true">↗</span></a><a class="text-link" href="#features">できることを見る <span aria-hidden="true">↓</span></a></div> <p class="hero-note">登録不要で閲覧・カートをお試しいただけます。実際の決済は行われません。</p> </div> <figure class="showcase" aria-label="商品・記事・運営をつなぐ売り場のコンセプトイメージ"> <div class="showcase-grid" aria-hidden="true"></div> <div class="store-preview"> <div class="preview-header"><span>暮らしの道具店</span><span aria-hidden="true">☰</span></div> <div class="product-art" aria-hidden="true"><span class="art-caption">毎日を、少し豊かに。</span><div class="circle"></div><div class="mug"><div class="mug-handle"></div></div><div class="art-shadow"></div><span class="art-label">お気に入りの、ひと品。</span></div> <div class="preview-product"><span class="tiny-label">暮らしになじむ道具</span><h2>いつもの時間が、好きになる。</h2><div class="preview-bottom"><span class="swatches" aria-label="色の選択肢"><i></i><i></i><i></i></span><a href="/shop/enamel-mug">商品を見る <span aria-hidden="true">↗</span></a></div></div> </div> <div class="floating card-story"><span class="mini-icon" aria-hidden="true">✎</span><div><small>伝える</small><strong>商品の背景を、記事に。</strong></div></div> <div class="floating card-operation"><span class="mini-icon" aria-hidden="true">✓</span><div><small>お店を動かす</small><strong>商品・注文・在庫を管理</strong></div></div> <figcaption>売り場のコンセプトイメージです。公開デモの画面とは異なります。</figcaption> </figure> </section> <div class="capabilities" aria-label="主な機能"><div class="wrap"><span>商品を届ける</span><b aria-hidden="true">＋</b><span>想いを伝える</span><b aria-hidden="true">＋</b><span>日々の運営を整える</span><a href="#pricing">月額 <strong>9,800</strong> 円で提供予定 <span aria-hidden="true">↗</span></a></div></div> <section class="section wrap" id="features" aria-labelledby="features-title"> <div class="section-heading"><p class="eyebrow">ダッシュコマースで、できること</p><h2 id="features-title">売るための機能を、<br>届けるための体験へ。</h2><p>商品を並べるところから、その魅力を伝えるところまで。<br>お店の個性に合わせて、販売と発信をつなげられます。</p></div> <div class="feature-grid">{features.map((c) => <article class="feature"><span class="feature-number">{c.n}</span><h3>{c.title}</h3><p>{c.body}</p><div class="tags">{c.tags.map((d) => <span>{d}</span>)}</div></article>)}</div> <p class="section-note">基盤となるECツールの機能を紹介しています。正式サービスでの提供範囲は未定です。決済・定期購入・ダウンロードには実運用の設定が必要です。</p> </section> <section class="operations section" aria-labelledby="operations-title"><div class="wrap operations-inner"> <div><p class="eyebrow">お店の裏側も、ひとつの場所に</p><h2 id="operations-title">日々の確認を整えて、<br>次の商品を考える時間へ。</h2><p>商品情報、在庫、注文を管理画面で確認。<br>販売の状況をつかみながら、お店を育てる次の一手を考えられます。</p><p class="small-print">管理機能は基盤ツールの機能です。公開デモでは管理画面にアクセスできません。</p></div> <div class="operations-list"><div><span aria-hidden="true">01</span><div><h3>商品を整える</h3><p>商品情報・価格・バリエーションを管理。</p></div></div><div><span aria-hidden="true">02</span><div><h3>注文を確かめる</h3><p>注文の一覧と詳細、対応状況を確認。</p></div></div><div><span aria-hidden="true">03</span><div><h3>在庫を把握する</h3><p>商品ごとの在庫や、在庫が少ない商品を確認。</p></div></div></div> </div></section> <section class="section wrap demo-section" aria-labelledby="demo-title"><div class="section-heading"><p class="eyebrow">まずは、お客さまの目線で</p><h2 id="demo-title">あなたのお店なら、<br>何を届けますか？</h2><p>サンプル商品を選んで、カートに入れてみる。<br>お客さまが買い物をする流れを、公開デモでお試しください。</p></div><div class="demo-steps"><a href="/shop"><span>01</span><h3>商品を探す</h3><p>一覧から、気になる商品へ。</p><b aria-hidden="true">↗</b></a><a href="/shop/graphic-tee"><span>02</span><h3>選択肢を見る</h3><p>色やサイズを選ぶ体験を。</p><b aria-hidden="true">↗</b></a><a href="/cart"><span>03</span><h3>カートを確認する</h3><p>追加した商品の数量を調整。</p><b aria-hidden="true">↗</b></a></div><p class="section-note">記事など、データベース上のサンプル原稿には英語が残っていることがあります。注文・決済・アカウント登録は無効です。</p></section> <section class="pricing section" id="pricing" aria-labelledby="pricing-title"><div class="wrap pricing-inner"><div><p class="eyebrow">サービス提供に向けて準備中</p><h2 id="pricing-title">お店の可能性を、<br>月額9,800円で。</h2><p>あなたの商品を届けるためのECサービスとして、<br>月額9,800円での提供を予定しています。</p></div><div class="price-card"><span class="planned">サービス提供予定価格</span><p class="price"><small>月額</small>9,800<span>円</span></p><p>商品代金ではなく、ECサービスの利用料金です。</p><a class="button primary" href="/shop">まずは公開デモを体験 <span aria-hidden="true">↗</span></a><p class="price-terms">税込・税別、初期費用、決済手数料、提供機能、サポート範囲、契約・解約条件は未定です。現在、お申し込みや課金は行っていません。</p></div></div></section> <section class="section wrap faq-section" id="faq" aria-labelledby="faq-title"><div><p class="eyebrow">ご利用を検討中の方へ</p><h2 id="faq-title">よくある質問</h2></div><div class="faq-list">{faqs.map(([c,d]) => <details><summary>{c}<span aria-hidden="true">＋</span></summary><p>{d}</p></details>)}</div></section> <section class="last-cta wrap"><div><p class="eyebrow">次は、あなたの売り場を。</p><h2>届けたいものがある。<br>その一歩を、ここから。</h2></div><a class="button primary" href="/shop">公開デモを体験する <span aria-hidden="true">↗</span></a></section> </main> <footer class="footer wrap"><a class="brand" href="/" aria-label="ダッシュコマース ホーム"><span class="brand-symbol" aria-hidden="true">d<span>↗</span></span><span>ダッシュコマース</span></a><nav aria-label="フッターナビゲーション"><a href="#features">できること</a><a href="#pricing">料金</a><a href="#faq">よくある質問</a><a href="/shop">公開デモ</a></nav><p>ダッシュコマース · サービス提供準備中</p></footer> </body></html>

