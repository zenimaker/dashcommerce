---
import Shop from "../../layouts/Shop.astro";
import { SANDBOXED } from "../../lib/edition";

// Core-only feature: not available in the sandboxed edition.
if (SANDBOXED) return new Response("ページが見つかりません", { status: 404, headers: { "content-type": "text/plain; charset=utf-8" } });
---
<Shop title="アカウント" description="注文の確認と、請求・定期購入の管理をメールで行います。">
	<div class="container-narrow acc-wrap">
		<h1>アカウント</h1>
		<p class="lead">
			アカウントは<strong>メールアドレスで紐づきます</strong>。会員登録は不要で、レジで入力したメールアドレスが、そのままアカウントになります。
		</p>

		<section class="explainer">
			<h2>仕組み</h2>
			<ul>
				<li>
					<strong>領収書とワンタイムリンク。</strong> 注文、返金、定期購入の管理リンクはメールで届きます。パスワードはなく、共有端末を気にする必要もありません。
				</li>
				<li>
					<strong>カートのリマインド。</strong> レジでメールアドレスを入力したまま購入を完了しなかった場合、カートに戻るリンクをメールします。
				</li>
				<li>
					<strong>次の買い物。</strong> この端末では入力内容を端末内に記憶するので、毎回打ち直す必要がありません。住所は注文が確定するまでサーバーに保存しません。
				</li>
			</ul>
		</section>

		<section class="lookup">
			<h2>過去の注文を探す</h2>
			<p>
				領収書が見つからないときは、確認メールに記載の注文IDから注文を表示できます。
			</p>
			<a class="acc-cta acc-cta--primary" href="/orders/lookup">
				注文を検索 <span aria-hidden="true">→</span>
			</a>
		</section>

		<section class="lookup">
			<h2>請求と定期購入の管理</h2>
			<p>
				カードの更新、請求書のダウンロード、定期購入の管理は、Stripeの安全な請求ポータルで行います。メールアドレスを入力すると、一度きり有効なリンクをお送りします。
			</p>
			<form id="portal-form" class="portal-form" novalidate>
				<label class="portal-label">
					<span>メールアドレス</span>
					<input
						required
						type="email"
						name="email"
						id="portal-email"
						autocomplete="email"
						placeholder="example@example.com"
					/>
				</label>
				<button type="submit" class="acc-cta acc-cta--primary" id="portal-submit">
					ポータルのリンクをメールする <span aria-hidden="true">→</span>
				</button>
				<p class="portal-status" id="portal-status" role="status"></p>
			</form>
		</section>

		<nav class="acc-cards" aria-label="ショートカット">
			<a class="acc-card" href="/shop">
				<h3>買い物を続ける</h3>
				<p>商品一覧を見る。</p>
				<span class="acc-card-arrow" aria-hidden="true">→</span>
			</a>
			<a class="acc-card" href="/cart">
				<h3>カート</h3>
				<p>途中から続ける。</p>
				<span class="acc-card-arrow" aria-hidden="true">→</span>
			</a>
		</nav>
	</div>
</Shop>

<style is:global>
	/* Scoped manually via .acc-wrap parent so these rules don't leak to other
	   pages. (Astro's automatic scoping was not applying reliably in the dev
	   HMR for this page.) */
	.acc-wrap { padding: 3rem 0 5rem; }

	.acc-wrap h1 { color: var(--text); }

	.acc-wrap .lead {
		color: var(--text-mid);
		font-size: 1rem;
		max-width: 42rem;
	}
	.acc-wrap .lead strong,
	.acc-wrap .lead em { color: var(--text); font-style: normal; font-weight: 600; }

	.acc-wrap .explainer,
	.acc-wrap .lookup {
		margin-top: 2.5rem;
		padding: 1.5rem 1.75rem;
		background: var(--bg-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		color: var(--text);
	}
	.acc-wrap .explainer h2,
	.acc-wrap .lookup h2 {
		margin: 0 0 .75rem;
		font-family: var(--font-sans);
		font-size: .78rem;
		letter-spacing: .08em;
		text-transform: uppercase;
		color: var(--text-muted);
		font-weight: 600;
	}
	.acc-wrap .explainer ul { margin: 0; padding-left: 1.25rem; display: grid; gap: .75rem; }
	.acc-wrap .explainer li { color: var(--text-mid); line-height: 1.55; }
	.acc-wrap .explainer strong { color: var(--text); }
	.acc-wrap .lookup p {
		margin: 0 0 1.25rem;
		color: var(--text-mid);
	}

	.acc-wrap .acc-cta {
		display: inline-flex; align-items: center; gap: .4rem;
		padding: .75rem 1.5rem;
		border-radius: var(--radius);
		font-family: var(--font-sans);
		font-size: .9rem;
		font-weight: 600;
		letter-spacing: .025em;
		text-decoration: none;
		transition: background var(--dur) var(--ease), border-color .2s, transform .15s;
	}
	.acc-wrap .acc-cta--primary {
		background: var(--gold);
		color: var(--accent-on, #0b0b0b);
		border: 1px solid var(--gold);
	}
	.acc-wrap .acc-cta--primary:hover {
		background: var(--gold-light);
		border-color: var(--gold-light);
		transform: translateY(-1px);
		text-decoration: none;
	}

	.acc-wrap .acc-cards {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 2rem;
	}
	.acc-wrap .acc-card {
		position: relative;
		display: block;
		padding: 1.5rem 2.5rem 1.5rem 1.5rem;
		background: var(--bg-2);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		color: var(--text);
		text-decoration: none;
		transition: border-color .15s, background .15s, transform .15s;
	}
	.acc-wrap .acc-card:hover {
		background: var(--surface);
		border-color: var(--gold);
		text-decoration: none;
		transform: translateY(-1px);
	}
	.acc-wrap .acc-card h3 {
		margin: 0 0 0.25rem;
		color: var(--text);
		font-family: var(--font-display);
	}
	.acc-wrap .acc-card p {
		margin: 0;
		color: var(--text-mid);
		font-size: 0.9rem;
	}
	.acc-wrap .acc-card-arrow {
		position: absolute;
		right: 1rem; top: 50%;
		transform: translateY(-50%);
		color: var(--gold);
		font-size: 1.1rem;
		transition: transform .15s;
	}
	.acc-wrap .acc-card:hover .acc-card-arrow { transform: translate(2px, -50%); }

	@media (max-width: 600px) {
		.acc-wrap .acc-cards { grid-template-columns: 1fr; }
	}

	.acc-wrap .portal-form {
		display: grid;
		gap: 1rem;
		max-width: 28rem;
	}
	.acc-wrap .portal-label {
		display: flex;
		flex-direction: column;
		gap: .4rem;
		font-size: .82rem;
		font-weight: 500;
		color: var(--text-muted);
	}
	.acc-wrap .portal-label input {
		padding: .7rem .9rem;
		background: var(--bg-3);
		color: var(--text);
		border: 1px solid var(--border-mid);
		border-radius: var(--radius);
		font-family: var(--font-sans);
		font-size: .9rem;
		transition: border-color .2s, box-shadow .2s;
	}
	.acc-wrap .portal-label input:focus {
		outline: none;
		border-color: var(--gold);
		box-shadow: 0 0 0 3px var(--gold-dim);
	}
	.acc-wrap .portal-status {
		margin: 0;
		font-size: .85rem;
		color: var(--text-mid);
		min-height: 1.2em;
	}
	.acc-wrap .portal-status.is-error { color: var(--ember); }
	.acc-wrap .portal-status.is-success { color: var(--text); }
</style>

<script>
	const API = "/_emdash/api/plugins/dashcommerce";
	const form = document.getElementById("portal-form") as HTMLFormElement | null;
	const input = document.getElementById("portal-email") as HTMLInputElement | null;
	const submit = document.getElementById("portal-submit") as HTMLButtonElement | null;
	const status = document.getElementById("portal-status");

	function setStatus(msg: string, tone: "info" | "error" | "success" = "info") {
		if (!status) return;
		status.textContent = msg;
		status.classList.remove("is-error", "is-success");
		if (tone === "error") status.classList.add("is-error");
		if (tone === "success") status.classList.add("is-success");
	}

	form?.addEventListener("submit", async (ev) => {
		ev.preventDefault();
		const email = (input?.value ?? "").trim();
		if (!email) {
			setStatus("レジで使ったメールアドレスを入力してください。", "error");
			return;
		}
		if (submit) { submit.disabled = true; submit.textContent = "送信しています…"; }
		setStatus("");
		try {
			const res = await fetch(`${API}/customer/portal-link`, {
				method: "POST",
				credentials: "include",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ email, returnUrl: `${window.location.origin}/account` }),
			});
			const body = await res.json().catch(() => ({}));
			if (!res.ok) {
				setStatus(
					(body as { error?: string }).error ?? `問題が発生しました（${res.status}）。`,
					"error",
				);
				return;
			}
			setStatus(
				"そのメールアドレスの請求アカウントがある場合、ポータルのリンクを送信しました。受信箱をご確認ください。",
				"success",
			);
			if (input) input.value = "";
		} catch {
			setStatus("通信エラーです。もう一度お試しください。", "error");
		} finally {
			if (submit) {
				submit.disabled = false;
				submit.innerHTML = 'ポータルのリンクをメールする <span aria-hidden="true">→</span>';
			}
		}
	});
</script>
